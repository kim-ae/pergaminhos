	"nodes":[
		{"id":"93846cf3090b6f89","type":"text","text":"What is the image registry?","x":0,"y":-140,"width":250,"height":60},
		{"id":"6744b781715f6502","type":"text","text":"Deployment","x":-460,"y":-180,"width":250,"height":60},
