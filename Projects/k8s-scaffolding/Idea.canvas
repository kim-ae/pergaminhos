		{"id":"bb4e9e2619a93de3","type":"text","text":"Is the application stateless?","x":0,"y":-240,"width":250,"height":60},
		{"id":"551f788a61282ffc","type":"text","text":"I would like to configure the tool to have steps that could be required or optional","x":-1000,"y":-20,"width":250,"height":120},
		{"id":"b578d0401e3e73e5","type":"text","text":"Do you want automatic update?","x":0,"y":410,"width":250,"height":60},
