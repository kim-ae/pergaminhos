		{"id":"079e4c96413d8657","type":"text","text":"Is your application nodejs or java?","x":0,"y":-20,"width":250,"height":60},
		{"id":"cdb1b63b5730a6f9","type":"text","text":"Is this serve port correct?","x":320,"y":-20,"width":250,"height":60},
		{"id":"d77eb91c27466d75","type":"text","text":"Do you have any metrics server?","x":0,"y":70,"width":250,"height":60},
